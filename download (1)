root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,hpp,inl,glsl,vert,frag,comp,lua,cmake}]
indent_style = tab
indent_size = 4

[{CMakeLists.txt,*.yaml,*.yml,*.json,*.oscene,*.oprefab,*.oproj}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
